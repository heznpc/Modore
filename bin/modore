#!/bin/bash -p
# Modore's narrow local command surface for session continuity and storage recovery.

set -u
set -o pipefail
umask 077
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
unset BASH_ENV ENV CDPATH GLOBIGNORE PYTHONHOME PYTHONPATH
# The repository scripts expose PCH_* overrides only to their own test and
# signed-runtime harnesses. An installed command must not let caller-provided
# overrides redirect a sourced module, state directory, or test fixture.
for OVERRIDE_NAME in "${!PCH_@}"; do
    unset "$OVERRIDE_NAME"
done
if [[ "$(/usr/bin/uname -s)" == "Darwin" ]]; then
    CURRENT_UID="$(/usr/bin/id -u)" || exit 64
    TRUSTED_HOME="$(/usr/bin/dscacheutil -q user -a uid "$CURRENT_UID" 2>/dev/null \
        | /usr/bin/awk '$1 == "dir:" {sub(/^[^:]*:[[:space:]]*/, ""); print; exit}')"
    [[ "$TRUSTED_HOME" == /* && "$TRUSTED_HOME" != "/" \
        && -d "$TRUSTED_HOME" && ! -L "$TRUSTED_HOME" ]] || exit 64
    HOME="$(cd -P "$TRUSTED_HOME" && /bin/pwd -P)" || exit 64
    export HOME
fi

usage() {
    /usr/bin/printf '%s\n' \
        'Usage:' \
        '  modore sessions [--limit N]' \
        '  modore ci status|refresh [--discover] [--repo owner/name] [--project PATH]' \
        '  modore betacue status' \
        '  modore sessions current' \
        '  modore sessions backup SOURCE --out NEW.zip --include-sensitive' \
        '  modore sessions backup-verify ARCHIVE.zip' \
        '  modore sessions backup-restore|backup-recovery|backup-resume ARCHIVE.zip --out NEW_FOLDER' \
        '  modore skills status|compare|disable|restore [--id ID] [--fingerprint HASH]' \
        '  modore search [--provider NAME] [--workspace PATH] [--exclude-workspace PATH] [--workspace-exact] [--cursor TOKEN|--offset N|--first] [--limit N] [--budget-seconds N]  # query on stdin' \
        '  modore resources status|acquire|claim|heartbeat|release [options]' \
        '  modore resources bind|unbind --id ID --provider PROVIDER --session ID --project PATH [--fingerprint HASH]' \
        '  modore resources diagnose-hooks --project PATH' \
        '  modore resources begin-test|hold --provider codex|claude --session ID --turn ID [options]' \
        '  modore resources begin-browser-test --provider codex|claude --session ID --project PATH --turn ID --url URL [--headed]' \
        '  modore resources install-hooks --provider codex|claude' \
        '  modore tools status|resolve PACKAGE[@VERSION]' \
        '  modore tools run PACKAGE[@VERSION] -- [arguments]' \
        '  modore storage status' \
        '  modore storage explain [--since ISO-TIMESTAMP]' \
        '  modore storage recovery' \
        '  modore cleanup list' \
        '  modore mcp tools'
}

fail_usage() {
    /usr/bin/printf 'ERROR: %s\n' "$1" >&2
    usage >&2
    exit 64
}

bounded_positive_integer() {
    local value="$1"
    local maximum="$2"
    [[ "$value" =~ ^[0-9]{1,6}$ ]] || return 1
    value=$((10#$value))
    [[ "$value" -ge 1 && "$value" -le "$maximum" ]]
}

# Follow an installation symlink so the repository remains the one source of
# truth for scripts and skills. macOS 13 does not ship realpath(1).
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    LINK_TARGET="$(/usr/bin/readlink "$SCRIPT_PATH")" || exit 1
    case "$LINK_TARGET" in
        /*) SCRIPT_PATH="$LINK_TARGET" ;;
        *) SCRIPT_PATH="$(/usr/bin/dirname "$SCRIPT_PATH")/$LINK_TARGET" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(/usr/bin/dirname "$SCRIPT_PATH")" && /bin/pwd -P)" || exit 1
PROJECT_ROOT="$(cd -P "$SCRIPT_DIR/.." && /bin/pwd -P)" || exit 1

SCREE="$PROJECT_ROOT/scripts/scree.py"
STORAGE_WATCH="$PROJECT_ROOT/scripts/storage_watch.sh"
CLEANUP="$PROJECT_ROOT/scripts/cleanup.sh"
MCP_SERVER="$PROJECT_ROOT/scripts/mcp_server.py"
BOUNDED_EXEC="$PROJECT_ROOT/scripts/bounded_exec.py"

for REQUIRED_FILE in "$SCREE" "$STORAGE_WATCH" "$CLEANUP" "$MCP_SERVER" "$BOUNDED_EXEC"; do
    [[ -f "$REQUIRED_FILE" && ! -L "$REQUIRED_FILE" ]] \
        || { /usr/bin/printf 'ERROR: Modore runtime is incomplete.\n' >&2; exit 1; }
done

# Storage attribution uses the native collector without resolving a Python runtime.
if [[ "${1:-}" == "storage" && "${2:-}" == "explain" ]]; then
    shift 2
    NATIVE_MODE="$PROJECT_ROOT/build/macos/Modore.app/Contents/MacOS/Modore"
    NATIVE_MARKER="$PROJECT_ROOT/build/macos/Modore.app/Contents/Resources/native-storage-attribution-v1"
    [[ -x "$NATIVE_MODE" && -f "$NATIVE_MARKER" ]] || {
        /usr/bin/printf 'ERROR: rebuild the native Mac app before running storage explain.\n' >&2
        exit 69
    }
    exec "$NATIVE_MODE" --storage-explain "$@"
fi

# Native operations share the signed app implementation. Reject an older app
# before launching so these flags can never accidentally open its GUI.
if [[ "${1:-}:${2:-}" == "resources:delete-duplicate" ]]; then
    fail_usage 'simulator devices are preserved; deletion is unavailable.'
fi
NATIVE_COMMAND=0
case "${1:-}:${2:-}" in
    ci:*|skills:*|sessions:backup|sessions:backup-verify|sessions:backup-restore|sessions:backup-recovery|sessions:backup-resume)
        NATIVE_COMMAND=1 ;;
    resources:|resources:status|resources:memory|resources:diagnose-hooks|resources:acquire|resources:claim|resources:bind|resources:unbind|resources:boot|resources:shutdown|resources:prefer|resources:eject)
        NATIVE_COMMAND=1 ;;
esac
if [[ "$NATIVE_COMMAND" == "1" ]]; then
    NATIVE_MODE="$PROJECT_ROOT/build/macos/Modore.app/Contents/MacOS/Modore"
    NATIVE_MARKER="$PROJECT_ROOT/build/macos/Modore.app/Contents/Resources/native-operations-v2"
    [[ -x "$NATIVE_MODE" && -f "$NATIVE_MARKER" ]] || {
        /usr/bin/printf 'ERROR: rebuild the native Mac app before running this command.\n' >&2
        exit 69
    }
    exec "$NATIVE_MODE" --native-cli "$@"
fi

if [[ -x /usr/bin/python3 ]]; then
    PYTHON=/usr/bin/python3
else
    PYTHON="$(command -v python3 2>/dev/null)" \
        || { /usr/bin/printf 'ERROR: python3 is required.\n' >&2; exit 69; }
fi

COMMAND="${1:-help}"
[[ "$#" -eq 0 ]] || shift

case "$COMMAND" in
    tools)
        exec "$PYTHON" -I -B "$PROJECT_ROOT/scripts/tool_reuse.py" "$@"
        ;;
    betacue)
        [[ "$#" -eq 1 && "$1" == "status" ]] || fail_usage 'betacue requires status with no additional arguments.'
        exec "$PYTHON" -I -B "$BOUNDED_EXEC" 5 -- \
            "$PYTHON" -I -B "$PROJECT_ROOT/scripts/betacue_state.py" status
        ;;
    help|-h|--help)
        usage
        ;;
    environments)
        [[ "${1:-}" == "status" ]] || fail_usage 'environments requires status.'
        shift
        exec "$PYTHON" -I -B "$PROJECT_ROOT/scripts/environment_retirement.py" --inventory "$@"
        ;;
    resources)
        exec "$PYTHON" -I -B "$PROJECT_ROOT/scripts/work_resources.py" "$@"
        ;;
    sessions)
        if [[ "${1:-}" == "current" ]]; then
            [[ "$#" -eq 1 ]] \
                || fail_usage 'sessions current accepts no additional arguments.'
            exec "$PYTHON" -I -B "$BOUNDED_EXEC" 5 -- \
                "$PYTHON" -I -B "$SCREE" sessions current
        fi
        SESSION_LIMIT=50
        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                --limit)
                    if [[ "$#" -lt 2 ]] \
                        || ! bounded_positive_integer "$2" 500; then
                        fail_usage '--limit must be between 1 and 500.'
                    fi
                    SESSION_LIMIT="$2"
                    shift 2
                    ;;
                *) fail_usage 'sessions accepts current or --limit.' ;;
            esac
        done
        exec "$PYTHON" -I -B "$BOUNDED_EXEC" 30 -- \
            "$PYTHON" -I -B "$SCREE" sessions --limit "$SESSION_LIMIT"
        ;;
    inspect)
        [[ "$#" -ge 1 ]] || fail_usage 'inspect requires one session source.'
        INSPECT_ARGS=(inspect "$1"); shift
        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                --start|--turns)
                    [[ "$#" -ge 2 && "$2" =~ ^[0-9]+$ ]] || fail_usage "$1 requires a nonnegative integer."
                    INSPECT_ARGS+=("$1" "$2"); shift 2 ;;
                *) fail_usage 'inspect accepts only --start and --turns.' ;;
            esac
        done
        exec "$PYTHON" -I -B "$BOUNDED_EXEC" 60 -- "$PYTHON" -I -B "$SCREE" "${INSPECT_ARGS[@]}"
        ;;
    search)
        [[ ! -t 0 ]] || fail_usage 'search reads an explicit user query from stdin, never argv.'
        SEARCH_SCOPE=()
        SEARCH_LIMIT=20
        SEARCH_BUDGET_SECONDS=30
        SEARCH_CURSOR=start
        SEARCH_LEGACY=0
        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                --limit|--budget-seconds)
                    [[ "$#" -ge 2 ]] || fail_usage "$1 requires a value."
                    [[ "$2" =~ ^[0-9]{1,12}$ ]] && [[ $((10#$2)) -gt 0 ]] \
                        || fail_usage "$1 requires a positive integer (at most 12 digits)."
                    SEARCH_REQUESTED=$((10#$2))
                    if [[ "$1" == "--limit" ]]; then
                        SEARCH_LIMIT="$SEARCH_REQUESTED"
                        if [[ "$SEARCH_LIMIT" -gt 200 ]]; then
                            SEARCH_LIMIT=200
                            /usr/bin/printf 'Search page limited to 200 matches; use nextCursor for the rest.\n' >&2
                        fi
                    else
                        SEARCH_BUDGET_SECONDS="$SEARCH_REQUESTED"
                        if [[ "$SEARCH_BUDGET_SECONDS" -gt 55 ]]; then
                            SEARCH_BUDGET_SECONDS=55
                            /usr/bin/printf 'Search page budget limited to 55 seconds; use nextCursor to continue.\n' >&2
                        fi
                    fi
                    shift 2
                    ;;
                --provider|--workspace|--exclude-workspace|--offset)
                    [[ "$#" -ge 2 ]] || fail_usage "$1 requires a value."
                    [[ "$1" != "--offset" ]] || SEARCH_LEGACY=1
                    SEARCH_SCOPE+=("$1" "$2")
                    shift 2
                    ;;
                --workspace-exact)
                    SEARCH_SCOPE+=("$1"); shift ;;
                --first)
                    SEARCH_LEGACY=1
                    SEARCH_FIRST=1
                    shift
                    ;;
                --cursor)
                    [[ "$#" -ge 2 && -n "$2" && ${#2} -le 4096 ]] || fail_usage '--cursor requires a returned nextCursor.'
                    SEARCH_CURSOR="$2"; shift 2 ;;
                *) fail_usage 'unsupported search option; send the query on stdin.' ;;
            esac
        done
        SEARCH_ARGS=(search --query-file /dev/stdin --limit "$SEARCH_LIMIT" \
            --budget-seconds "$SEARCH_BUDGET_SECONDS")
        [[ "${SEARCH_FIRST:-0}" == "0" ]] || SEARCH_ARGS+=(--first)
        if [[ "$SEARCH_LEGACY" == 0 ]]; then
            SEARCH_ARGS+=(--cursor "$SEARCH_CURSOR")
        elif [[ "$SEARCH_CURSOR" != start ]]; then
            fail_usage '--cursor cannot be combined with --offset or --first.'
        fi
        exec "$PYTHON" -I -B "$BOUNDED_EXEC" 60 -- \
            "$PYTHON" -I -B "$SCREE" "${SEARCH_ARGS[@]}" ${SEARCH_SCOPE[@]+"${SEARCH_SCOPE[@]}"}
        ;;
    storage)
        SUBCOMMAND="${1:-}"
        [[ "$#" -eq 0 ]] || shift
        case "$SUBCOMMAND" in
            status)
                [[ "$#" -eq 0 ]] || fail_usage 'storage status accepts no additional arguments.'
                "$PYTHON" -I -B "$BOUNDED_EXEC" 60 -- \
                    /bin/bash -p "$STORAGE_WATCH" --observe-only >/dev/null
                WATCH_STATUS=$?
                [[ "$WATCH_STATUS" == "0" || "$WATCH_STATUS" == "75" ]] \
                    || exit "$WATCH_STATUS"
                if [[ "$WATCH_STATUS" == "75" ]]; then
                    /usr/bin/printf 'watchStatus\tbusy\n'
                    /usr/bin/printf '%s\n' \
                        $'watchMessage\t다른 Modore 저장공간 점검이 실행 중입니다. 마지막 완료 기록을 표시합니다.'
                fi
                STATE="$HOME/Library/Application Support/Modore/storage-watch.tsv"
                [[ -f "$STATE" && ! -L "$STATE" ]] \
                    || { /usr/bin/printf 'ERROR: storage status was not written.\n' >&2; exit 1; }
                /bin/cat "$STATE"
                COMMITTED_CAPTURE="$(/usr/bin/awk -F '\t' \
                    '$1 == "lastEvidenceAt" {print $2; exit}' "$STATE")"
                case "$COMMITTED_CAPTURE" in
                    *$'\t'*|*$'\n'*|*$'\r'*) COMMITTED_CAPTURE="" ;;
                esac
                [[ "${#COMMITTED_CAPTURE}" -le 64 ]] || COMMITTED_CAPTURE=""
                [[ -z "$COMMITTED_CAPTURE" ]] \
                    || /usr/bin/printf 'evidenceAt\t%s\n' "$COMMITTED_CAPTURE"
                for EVIDENCE in \
                    "$HOME/Library/Application Support/Modore/storage-watch-signals.tsv" \
                    "$HOME/Library/Application Support/Modore/storage-watch-paths.tsv"; do
                    [[ -f "$EVIDENCE" && ! -L "$EVIDENCE" ]] || continue
                    [[ -n "$COMMITTED_CAPTURE" ]] || continue
                    case "$EVIDENCE" in
                        *-signals.tsv) EVIDENCE_KIND="signal" ;;
                        *) EVIDENCE_KIND="pathSnapshot" ;;
                    esac
                    /usr/bin/awk -F '\t' -v captured="$COMMITTED_CAPTURE" \
                        -v kind="$EVIDENCE_KIND" \
                        '$1 == captured { print kind "\t" $0 }' "$EVIDENCE"
                done
                ;;
            recovery)
                [[ "$#" -eq 0 ]] || fail_usage 'storage recovery accepts no target or approval flags.'
                [[ "$(/usr/bin/uname -s)" == "Darwin" ]] \
                    || { /usr/bin/printf 'ERROR: native recovery is available on macOS.\n' >&2; exit 69; }
                exec /usr/bin/open 'modore://storage/recovery'
                ;;
            *) fail_usage 'storage requires status or recovery.' ;;
        esac
        ;;
    cleanup)
        SUBCOMMAND="${1:-}"
        [[ "$#" -eq 0 ]] || shift
        case "$SUBCOMMAND" in
            list)
                [[ "$#" -eq 0 ]] || fail_usage 'cleanup list accepts no additional arguments.'
                exec "$PYTHON" -I -B "$BOUNDED_EXEC" 10 -- \
                    /bin/bash -p "$CLEANUP" --list
                ;;
            *) fail_usage 'cleanup requires list.' ;;
        esac
        ;;
    mcp)
        [[ "${1:-}" == "tools" && "$#" -eq 1 ]] || fail_usage 'mcp requires tools.'
        exec "$PYTHON" -I -B "$BOUNDED_EXEC" 10 -- \
            "$PYTHON" -I -B "$MCP_SERVER" --tools
        ;;
    *) fail_usage "unknown command: $COMMAND" ;;
esac
